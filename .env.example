# Copy to .env, fill in locally, and never commit or share it.
# scripts/*.ps1 require each database/session value to be a distinct 64-character
# hexadecimal secret. Hex also makes MYSQL_PASSWORD safe in DATABASE_URL.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
APP_SESSION_SECRET=
# A separate approval password: 20–128 ASCII letters, digits, _ or -.
# Keep it distinct from login passwords and other secrets; store it securely.
WIN_APPROVAL_PASSWORD=
